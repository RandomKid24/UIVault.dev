  "main": "befui.js",
  "style": "befui.css",
  "unpkg": "befui.js",
  "jsdelivr": "befui.js",
  "sideEffects": true,
  "exports": { ".": "./befui.js", "./befui.js": "./befui.js", "./befui.css": "./befui.css" },
